# THE PILOT LEAD — variables d'environnement
# Copier vers apps/lead/.env.local pour le dev. En prod : dashboard Render (service the-pilot-lead).
# Aucune valeur réelle ne doit être commitée. Rien n'est partagé avec THE PILOT (Seven At Home).

# --- Base de données : projet Supabase DÉDIÉ à The Pilot Lead (EU / Frankfurt) ---
# Rôle applicatif `app_lead` (RLS active, aucun bypass) — voir drizzle/roles.sql.
DATABASE_URL=postgres://app_lead:[password]@db.[project-ref].supabase.co:5432/postgres
# Rôle `postgres` : migrations, scripts d'administration UNIQUEMENT (jamais l'app).
DATABASE_ADMIN_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Secret partagé avec le cron Render qui appelle /api/cron/tick chaque minute.
CRON_SECRET=
# Chiffre les jetons OAuth Calendly et signe les liens acheteurs. `openssl rand -base64 48`.
SECRET_ENCRYPTION_KEY=
# Sel du hash des IP de consentement (preuve RGPD sans stocker l'IP). `openssl rand -hex 16`.
LEAD_HASH_SALT=

# --- Alertes setter : bot Telegram (@BotFather) ---
# Absent = aucune alerte envoyée, le reste fonctionne. Chaque utilisateur colle son chat id dans /utilisateurs.
TELEGRAM_BOT_TOKEN=

# --- Brevo (compte Breach / MEP — jamais celui de Seven) : emails transactionnels + SMS ---
BREVO_API_KEY=
EMAIL_SENDER_NAME=MonExpertPatrimoine
EMAIL_SENDER_ADDRESS=rdv@monexpertpatrimoine.fr
# Nom d'expéditeur SMS (11 caractères alphanumériques max, validé dans Brevo).
SMS_SENDER=MonExpert
# Modes test : tout envoi est redirigé vers l'adresse / le numéro de test (anti-accident).
EMAIL_TEST_MODE=true
EMAIL_TEST_ADDRESS=
SMS_TEST_MODE=true
SMS_TEST_NUMBER=

# --- Meta Conversions API (pixel / dataset de MEP, jamais celui de Seven) ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Code « test events » du Gestionnaire d'événements, pour vérifier sans polluer.
META_CAPI_TEST_EVENT_CODE=

# --- Calendly : app OAuth dédiée à The Pilot Lead (l'acheteur relie son compte) ---
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- DEV UNIQUEMENT : désactive l'authentification en local (sans effet en production) ---
DISABLE_AUTH=
